# Copiar a .env y completar (NUNCA commitear .env)
# Generar API_KEY: openssl rand -hex 32

# --- Base de datos (POSTGRES_PASSWORD y DB_PASS deben ser iguales) ---
# IMPORTANTE: si ya existe la carpeta pgdata/, la contraseña debe coincidir con la
# que se uso al crear la BD (dev por defecto: clima1234). Cambiar aqui sin recrear
# pgdata provoca "password authentication failed" y mapa sin estaciones.
POSTGRES_PASSWORD=clima1234
DB_PASS=clima1234
DB_USER=postgres
DB_NAME=clima
DB_HOST=timescaledb
DB_PORT=5432

# --- API Plumber ---
# Vacio en dev local = API sin autenticacion. En prod: obligatorio.
API_KEY=

# Clave para endpoints /admin/* y dashboard /registro_descargas/
ADMIN_API_KEY=

# Origenes CORS permitidos (coma-separados). Vacio = Allow-Origin * (solo dev).
ALLOWED_ORIGINS=https://app.rodaja.cl,https://rodaja.cl,https://www.rodaja.cl

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Shiny (dev local puede usar http://localhost:8000 si API expuesta) ---
API_URL=http://api:8000

# CARTO raster Positron (Leaflet). Public browser key; domain-bound to app.rodaja.cl.
# Request: https://carto.com/basemaps/apikey/
CARTO_BASEMAP_KEY=

# --- Clerk (auth usuarios) â€” ver docs/setup/CLERK_SETUP.md ---
# Vacio = auth desactivada; visitantes siempre anonimos.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_ACCOUNT_URL=https://accounts.rodaja.cl
CLERK_WEBHOOK_SECRET=

# --- Email transaccional (descargas + alertas top 10) ---
# Hostinger ejemplo: smtp.hostinger.com, puerto 587 (TLS) o 465 (SSL)
# Si SMTP_HOST esta vacio, no se envian correos.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=admin@rodaja.cl
SMTP_PASS=
SMTP_FROM=admin@rodaja.cl
# IMAP para leer avisos de rebote (MAILER-DAEMON) antes de enviar alertas.
# Si no se definen, se usa imap.hostinger.com:993 con SMTP_USER / SMTP_PASS
# cuando la cuenta es la misma.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# Destino del formulario /formulario/ (default: SMTP_FROM)
# CONTACT_TO=admin@rodaja.cl

# URL publica de la app (links en emails de alertas)
APP_PUBLIC_URL=https://app.rodaja.cl

# --- Marketing / Analytics (GTM, GA4, AdSense) â€” ver marketing/MANUAL_SETUP.md ---
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
ADSENSE_PUBLISHER_ID=
GOOGLE_ADS_CONVERSION_ID=
SITE_CANONICAL_BASE=https://app.rodaja.cl

# --- Open-Meteo (pronostico batch) ---
# Vacio = api.open-meteo.com (tier free). Prod comercial: customer-api.open-meteo.com + OPENMETEO_API_KEY
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_API_KEY=
OPENMETEO_FORECAST_DAYS=16
OPENMETEO_CHUNK_SIZE=100
# Bias correction (post-procesado Open-Meteo). 0=desactivado; rollback instantaneo.
# Apply escribe valor (corregido) + valor_crudo; train siempre sobre staging historico crudo.
OPENMETEO_BIAS_ENABLED=0
BIAS_MIN_SAMPLE=30
BIAS_MIN_SAMPLE_PP=20
# Holdout temporal como fraccion de la serie (usado). BIAS_HOLDOUT_YEARS esta deprecado.
BIAS_HOLDOUT_FRAC=0.2
#BIAS_HOLDOUT_YEARS=1
BIAS_DECAY_HALFLIFE_DAYS=45
# Leads: 0 = Historical Forecast API; 1-3 = Previous Runs API (hourly *_previous_dayN).
# El resolver de fases baja lead 0 primero; al completar, pasa solo a leads 1-3 en estaciones de alertas.
BIAS_HIST_LEADS=0,1,2,3
# Inicio de ventana util de leads con precipitacion (~feb-2024 en Previous Runs).
BIAS_LEAD_START=2024-01-01
# Piso anios_span para scope=alertas (excelente).
BIAS_ALERT_MIN_ANIOS=20
# No recalcular coeficientes "oficiales" bajo este % de backfill (salvo --force / -ForceCalc)
BIAS_CALC_MIN_BACKFILL_PCT=80
# Cuota free Open-Meteo compartida: FORECAST_RESERVE es piso; el historico
# tambien reserva max(piso, estimacion segun estaciones buena|excelente).
OPENMETEO_FREE_DAILY_LIMIT=10000
OPENMETEO_FORECAST_RESERVE=2500
OPENMETEO_CALL_SAFETY_MARGIN=200
# Tope max historico/dia (0 = solo remanente dinamico tras pronostico)
BIAS_DAILY_CALL_BUDGET=0
BIAS_HISTORICAL_START=2021-01-01
OPENMETEO_HISTORICAL_BASE_URL=https://historical-forecast-api.open-meteo.com/v1
OPENMETEO_PREVIOUSRUNS_BASE_URL=https://previous-runs-api.open-meteo.com/v1

# --- Flow (cobros Pro Chile) â€” ver docs/setup/FLOW_SETUP.md ---
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_PLAN_PRO_MONTHLY=rodaja_pro_mensual
# FLOW_BASE_URL=   # opcional; vacío = auto según FLOW_ENV

# --- Pago por uso (descargas on-demand) ---
ON_DEMAND_CLP_PER_BYTE=0.00003
ON_DEMAND_CHARGE_THRESHOLD_CLP=1000


# --- Cloudflare (cache edge del reporte + purga post-ingesta) ---
# Token: Zone.Cache Purge + Zone.Cache Rules Edit + Zone.Zone Read
# Zone ID: overview de rodaja.cl en el dashboard.
# CF_API_TOKEN=
# CF_ZONE_ID=
# --- Stripe (deprecated â€” reemplazado por Flow) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_PRO_MONTHLY=

# --- Reporte PDF por estacion (en pausa hasta el Reporte personalizado) ---
# 1 = reactiva endpoints, boton del mapa y jobs del worker. Vacio o 0 = en pausa.
REPORTE_PDF_HABILITADO=0
