<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/widget_offer_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_offer_pin"
        android:textColor="#111111"
        android:textSize="18sp" />

    <Button
        android:id="@+id/widget_offer_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/widget_offer_add" />

    <Button
        android:id="@+id/widget_offer_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_offer_close" />
</LinearLayout>
