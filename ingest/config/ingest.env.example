# Conexion desde host Windows hacia servicios Docker en localhost.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clima
DB_USER=postgres
DB_PASS=clima1234

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Ruta opcional para archivos crudos descargados
INGEST_STAGING_DIR=ingest/staging

# DGA / SNIA (pool diferido: cascada newest, max 12, adapt TARGET_SEC=20, retry x3)
# INGEST_DGA_TIMEOUT_SEC=210
# INGEST_DGA_CONCURRENCY=12
# INGEST_DGA_RAMP_SEC=45
# INGEST_DGA_TARGET_SEC=20
# INGEST_DGA_MIN_INFLIGHT=2
# INGEST_DGA_MAX_RETRIES=3
